PORT=8000
NODE_ENV=production
CORS_ORIGIN=*

# Downstream Microservice Hostnames (Internal Docker Network)
USER_SERVICE_URL=http://user-service:5001
CATALOG_SERVICE_URL=http://catalog-service:5002
SEARCH_SERVICE_URL=http://search-service:5003
CART_SERVICE_URL=http://cart-service:5004
ORDER_SERVICE_URL=http://order-service:5005
PAYMENT_SERVICE_URL=http://payment-service:5006
INVENTORY_SERVICE_URL=http://inventory-service:5007
DELIVERY_SERVICE_URL=http://delivery-service:5008
REVIEW_SERVICE_URL=http://review-service:5009

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=200
