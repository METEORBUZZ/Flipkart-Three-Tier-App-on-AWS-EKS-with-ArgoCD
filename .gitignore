# =====================================================================
# SECURITY & SECRETS (STRICT SECURITY RULE: Never commit credentials)
# =====================================================================
# Exclude all live environment and secrets files
*.env
.env.*
!.env.example

# Exclude security keys, private certificates, and credentials
*.pem
*.key
*.cert
*.crt
credentials.json
secrets/

# =====================================================================
# DATABASE STORAGE & CONTAINER DATA (Local development data only)
# =====================================================================
postgres_data/
redis_data/

# =====================================================================
# DEPENDENCIES & BUILD ARTIFACTS (Do not commit compiled output)
# =====================================================================
# Node.js
node_modules/
.next/
dist/
build/
out/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
*.egg-info/

# Java / Maven
target/
*.class
*.jar
*.war

# Logs & Runtime Dumps
logs/
*.log
npm-debug.log*
yarn-debug.log*

# =====================================================================
# OS & IDE TEMPORARY FILES
# =====================================================================
.DS_Store
Thumbs.db
.idea/
.vscode/
